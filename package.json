{
  "name": "rent-record",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev --host",
    "dev:prod": "cross-env DB_MODE=PROD vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "migration:generate": "drizzle-kit generate:pg",
    "migration:push": "cd ./src/db && tsx migrate.ts",
    "migration:drop": "drizzle-kit drop",
    "migration:direct-push": "drizzle-kit push:pg",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "3.0.0",
    "@skeletonlabs/skeleton-svelte": "1.0.0",
    "@sveltejs/adapter-netlify": "^4.4.2",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/svelte-query-devtools": "^5.90.2",
    "@types/ms": "^0.7.34",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.20.18",
    "mode-watcher": "^0.3.1",
    "postgres": "^3.4.9",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.99.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-node": "^2.1.9"
  },
  "type": "module",
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@fontsource/roboto": "^5.2.10",
    "@neondatabase/serverless": "^0.8.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/svelte-query": "^5.90.2",
    "@trpc/client": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.6.11",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "devalue": "^5.8.0",
    "drizzle-orm": "^0.29.5",
    "drizzle-zod": "^0.5.1",
    "ms": "^2.1.3",
    "superjson": "^2.2.6",
    "svelte-icons-pack": "^3.1.3",
    "tailwind-merge": "^2.6.1",
    "trpc-svelte-query": "^2.1.0",
    "trpc-sveltekit": "^3.6.3",
    "zod": "^3.25.76"
  }
}
